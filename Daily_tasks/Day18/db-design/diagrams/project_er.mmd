
erDiagram
    BRANCH ||--o{ CAR : houses
    CAR ||--o{ RENTAL : has
    CUSTOMER ||--o{ RENTAL : makes
    CAR ||--o{ MAINTENANCE : undergoes

    BRANCH {
        int branchId PK
        string name
        string city
        string address
    }

    CAR {
        int carId PK
        int branchId FK
        string model
        string registrationNumber
        decimal pricePerDay
    }

    CUSTOMER {
        int customerId PK
        string name
        string email
        string phone
        string licenceNumber
        date licenceExpiryDate
    }

    RENTAL {
        int rentalId PK
        int customerId FK
        int carId FK
        date startDate
        date endDate
        decimal totalAmount
        string status
    }

    MAINTENANCE {
        int maintenanceId PK
        int carId FK
        date startDate
        date endDate
        string reason
    }
